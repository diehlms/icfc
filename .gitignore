# Ignore bundler config and local gems
**/.bundle

# SQLite
/db/*.sqlite3
/db/*.sqlite3-journal

# Rails logs and temp files
api/log/*
api/tmp/*
!api/log/.keep
!api/tmp/.keep

# Precompiled assets
/public/assets

# Uploaded files in development
/public/uploads/*
api/storage/*
!api/storage/.keep

# Secrets and local config
.env
.env.*
/config/master.key
/config/local_env.yml

# Terraform
terraform.tfvars
terraform.tfstate
terraform.tfstate.backup
.terraform/

# Byebug
.byebug_history

# macOS
**/*.DS_Store

# PG dumps
latest.dump

# Private content (cabin info, charitable gift pages)
api/app/assets/javascripts/cabins
api/app/views/pages/charitable_gift
