<nav class="bg-emerald-900 text-white flex items-center justify-between px-4 py-3 shadow-md" data-controller="search">
  <div class="flex items-center gap-3">
    <button data-action="click->sidebar#toggle"
            class="text-emerald-200 hover:text-white text-xl leading-none cursor-pointer"
            aria-label="Toggle navigation">☰</button>
    <a href="/" class="flex items-center gap-2 font-bold text-lg hover:text-emerald-200">
      <span>ICFC</span>
    </a>
  </div>

  <div class="flex-1 max-w-sm mx-6" data-search-target="container">
    <%= form_with url: search_path, method: :get, data: { action: "input->search#query", turbo: false }, class: "relative" do |f| %>
      <%= f.text_field :q,
            placeholder: "Search…",
            class: "w-full rounded px-3 py-1.5 text-sm text-gray-900 bg-white border-2 border-emerald-700 focus:border-emerald-400 focus:outline-none placeholder-gray-400",
            data: { search_target: "input", action: "keydown.esc->search#clear" },
            autocomplete: "off" %>
    <% end %>
    <div data-search-target="results"
         class="absolute z-50 bg-white text-gray-900 rounded shadow-lg mt-1 w-80 hidden"></div>
  </div>

  <div class="flex items-center gap-4 text-sm">
    <% if @current_user %>
      <span class="hidden sm:inline text-emerald-200">
        <%= @current_user.firstname %> <%= @current_user.lastname %>
      </span>
      <span class="w-8 h-8 rounded-full bg-emerald-700 flex items-center justify-center font-semibold text-xs">
        <%= user_initials %>
      </span>
      <%= link_to "Log out", logout_path, data: { turbo_method: :delete }, class: "hover:text-emerald-200" %>
    <% end %>
  </div>
</nav>
