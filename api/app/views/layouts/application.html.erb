<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="turbo-cache-control" content="no-preview">
    <%= favicon_link_tag 'favicon.png', type: 'image/png' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <title>Iron City Fishing Club</title>
    <%= stylesheet_link_tag "application", data: { turbo_track: "reload" } %>
    <%= stylesheet_link_tag "tailwind.css", data: { turbo_track: "reload" } %>
    <%= stylesheet_link_tag "lexxy" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <% if logged_in? %>
      <div data-controller="sidebar" class="flex flex-col min-h-screen">
        <%= render(NavbarComponent.new(current_user: current_user)) %>

        <% active_messages = CampMessage.where(expired: [false, nil]).order(created_at: :desc) %>
        <% if active_messages.any? || current_user.admin? %>
          <div class="bg-amber-50 border-b border-amber-200">
            <% active_messages.each do |msg| %>
              <div class="flex items-center justify-between px-4 py-2 text-sm text-amber-900">
                <span class="font-medium"><%= msg.message %></span>
                <% if current_user.admin? %>
                  <%= button_to camp_message_path(msg), method: :delete,
                        class: "text-amber-600 hover:text-amber-900 bg-transparent border-0 cursor-pointer ml-4",
                        title: "Dismiss" do %>
                    <%= heroicon "x-mark", options: { class: "w-4 h-4" } %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
            <% if current_user.admin? %>
              <details class="<%= active_messages.any? ? 'border-t border-amber-200' : '' %>">
                <summary class="px-4 py-1.5 text-xs text-amber-700 cursor-pointer hover:text-amber-900 list-none flex items-center gap-1">
                  <%= heroicon "plus-circle", options: { class: "w-3.5 h-3.5" } %> Post global message
                </summary>
                <%= form_with url: camp_messages_path, class: "px-4 pb-2 pt-1 flex gap-2" do |f| %>
                  <%= f.text_field :message, name: "camp_message[message]", placeholder: "Message to all members…",
                        required: true,
                        class: "flex-1 border border-amber-300 rounded px-3 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-amber-500 bg-white" %>
                  <%= f.submit "Post", class: "bg-amber-700 hover:bg-amber-800 text-white px-3 py-1 rounded text-sm cursor-pointer" %>
                <% end %>
              </details>
            <% end %>
          </div>
        <% end %>

        <div class="flex flex-1">
          <%= render(SidebarComponent.new(current_user: current_user)) %>

          <main class="flex-1 p-6 min-w-0 pb-16">
            <%= render(FlashComponent.new(flash: flash)) %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="fixed top-4 left-0 right-0 z-50 px-4 max-w-md mx-auto">
        <%= render(FlashComponent.new(flash: flash)) %>
      </div>
      <%= yield %>
    <% end %>

    <footer class="fixed bottom-0 left-0 right-0 bg-emerald-900 text-emerald-200 text-xs py-2 px-6 text-center z-10">
      &copy; <%= Date.today.year %> Iron City Fishing Club
    </footer>
  </body>
</html>
