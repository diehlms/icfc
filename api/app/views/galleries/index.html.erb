<div data-controller="modal">
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-emerald-900">Photos</h1>
  <button data-action="click->modal#open" class="btn-primary">Upload Photo</button>
</div>

<% if @galleries.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    <% @galleries.each do |gallery| %>
      <div class="relative group rounded overflow-hidden shadow">
        <img src="<%= gallery.image_url %>" alt="<%= gallery.caption %>"
             class="w-full h-40 object-cover">
        <% if gallery.caption.present? %>
          <div class="absolute bottom-0 inset-x-0 bg-black/50 text-white text-xs px-2 py-1 truncate">
            <%= gallery.caption %>
          </div>
        <% end %>
        <% if gallery.user_id == current_user.id || current_user.admin? %>
          <%= button_to gallery_path(gallery), method: :delete,
                class: "absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition cursor-pointer border-0",
                title: "Delete photo", data: { turbo_confirm: "Delete photo?" } do %>
            <%= heroicon "x-mark", options: { class: "w-3 h-3" } %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
  <%= will_paginate @galleries, class: "mt-6 flex justify-center gap-2" %>
<% else %>
  <p class="text-gray-500">No photos yet.</p>
<% end %>

<dialog data-modal-target="dialog" data-action="click->modal#backdropClose" class="modal-dialog">
  <div class="p-6 w-full">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">Upload Photo</h2>
      <button data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
        <%= heroicon "x-mark", options: { class: "w-5 h-5" } %>
      </button>
    </div>
    <%= form_with model: @gallery, multipart: true, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
      <% if @gallery.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
          <ul class="list-disc list-inside space-y-1">
            <% @gallery.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= f.label :image, class: "form-label" %>
        <%= f.file_field :image, accept: "image/*", required: true, class: "text-sm w-full" %>
        <%= render "shared/field_errors", object: @gallery, attribute: :image %>
      </div>
      <div>
        <%= f.label :caption, class: "form-label" %>
        <%= f.text_field :caption, class: "form-control" %>
      </div>
      <%= f.submit "Upload", data: { form_validity_target: "submit" }, class: "btn-primary w-full" %>
    <% end %>
  </div>
</dialog>
</div>
