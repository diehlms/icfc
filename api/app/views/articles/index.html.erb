<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-emerald-900">Articles</h1>
  <%= link_to "New Article", new_article_path, class: "btn-primary" %>
</div>

<div class="space-y-4">
  <% @articles.each do |article| %>
    <article class="bg-white rounded-lg shadow p-5">
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <h2 class="text-lg font-semibold">
            <%= link_to article.title, article, class: "text-emerald-800 hover:underline" %>
            <% if article.pinned? %>
              <span class="ml-2 text-xs bg-yellow-100 text-yellow-800 px-1.5 py-0.5 rounded">Pinned</span>
            <% end %>
          </h2>
          <p class="text-sm text-gray-500 mt-0.5">
            By <%= article.user&.firstname %> <%= article.user&.lastname %> &middot;
            <%= article.created_at.strftime('%B %-d, %Y') %>
          </p>
          <p class="text-gray-700 mt-2 text-sm"><%= truncate(strip_tags(article.content), length: 250) %></p>
        </div>
        <% if article.image? %>
          <img src="<%= article.image_url %>" alt="" class="w-24 h-16 object-cover rounded ml-4 flex-shrink-0">
        <% end %>
      </div>
    </article>
  <% end %>
</div>

<%= will_paginate @articles, class: "mt-6 flex justify-center gap-2" %>
