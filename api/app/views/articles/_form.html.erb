<%= form_with model: article, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
  <% if article.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
      <ul class="list-disc list-inside space-y-1">
        <% article.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "form-label" do %>Title<%= required_mark %><% end %>
    <%= f.text_field :title, required: true, maxlength: 50, class: "form-control" %>
    <%= render "shared/field_errors", object: article, attribute: :title %>
  </div>

  <div>
    <%= f.label :content, class: "form-label" do %>Content<%= required_mark %><% end %>
    <%= f.rich_text_area :content, required: true %>
    <%= render "shared/field_errors", object: article, attribute: :content %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :pinned, class: "rounded border-gray-300 text-emerald-600" %>
    <%= f.label :pinned, "Pin this article", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit article.persisted? ? "Save Changes" : "Publish Article", data: { form_validity_target: "submit" }, class: "btn-primary" %>
    <%= link_to "Cancel", article.persisted? ? article : articles_path, class: "text-sm text-gray-500 hover:underline self-center" %>
  </div>
<% end %>
