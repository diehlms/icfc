<h1 class="text-2xl font-bold text-emerald-900 mb-6">Search</h1>

<%= form_with url: search_path, method: :get, class: "mb-6 flex gap-2" do |f| %>
  <%= f.text_field :q, value: @query, placeholder: "Search articles, events, cabins, members…",
        class: "form-control flex-1",
        autofocus: true %>
  <%= f.submit "Search", class: "btn-primary" %>
<% end %>

<% if @query.present? %>
  <div class="space-y-6">
    <% if @articles&.any? %>
      <div>
        <h2 class="text-lg font-semibold text-gray-800 mb-2">Articles</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% @articles.each do |a| %>
            <div class="px-4 py-3">
              <%= link_to a.title, a, class: "font-medium text-emerald-700 hover:underline" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @events&.any? %>
      <div>
        <h2 class="text-lg font-semibold text-gray-800 mb-2">Events</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% @events.each do |e| %>
            <div class="px-4 py-3">
              <span class="font-medium"><%= e.title %></span>
              <span class="text-gray-500 text-sm ml-2"><%= e.start_time.strftime('%b %-d, %Y') %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @cabins&.any? %>
      <div>
        <h2 class="text-lg font-semibold text-gray-800 mb-2">Cabins</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% @cabins.each do |c| %>
            <div class="px-4 py-3">
              <%= link_to c.name, c, class: "font-medium text-emerald-700 hover:underline" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @users&.any? %>
      <div>
        <h2 class="text-lg font-semibold text-gray-800 mb-2">Members</h2>
        <div class="bg-white rounded-lg shadow divide-y">
          <% @users.each do |u| %>
            <div class="px-4 py-3">
              <%= link_to "#{u.firstname} #{u.lastname}", user_path(u), class: "font-medium text-emerald-700 hover:underline" %>
              <span class="text-gray-500 text-sm ml-2">@<%= u.username %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if [@articles, @events, @cabins, @users].all? { |r| r&.empty? } %>
      <p class="text-gray-500">No results found for "<%= @query %>".</p>
    <% end %>
  </div>
<% end %>
