<%= form_with model: event, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
  <% if event.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% event.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, required: true, maxlength: 50, class: "form-control" %>
    <%= render "shared/field_errors", object: event, attribute: :title %>
  </div>
  <div>
    <%= f.label :location, class: "form-label" %>
    <%= f.text_field :location, required: true, maxlength: 100, class: "form-control" %>
    <%= render "shared/field_errors", object: event, attribute: :location %>
  </div>
  <div>
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, required: true, maxlength: 10000, rows: 3, class: "form-control" %>
    <%= render "shared/field_errors", object: event, attribute: :description %>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :start_time, "Start", class: "form-label" %>
      <%= f.datetime_local_field :start_time, required: true, class: "form-control" %>
      <%= render "shared/field_errors", object: event, attribute: :start_time %>
    </div>
    <div>
      <%= f.label :end_time, "End", class: "form-label" %>
      <%= f.datetime_local_field :end_time, required: true, class: "form-control" %>
      <%= render "shared/field_errors", object: event, attribute: :end_time %>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <%= f.check_box :all_day, class: "rounded border-gray-300 text-emerald-600" %>
    <%= f.label :all_day, "All day", class: "text-sm text-gray-700" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit event.persisted? ? "Save Changes" : "Create Event", data: { form_validity_target: "submit" }, class: "btn-primary" %>
    <% if event.persisted? %>
      <%= link_to "Cancel", events_path, class: "text-sm text-gray-500 hover:underline self-center" %>
    <% end %>
  </div>
<% end %>
