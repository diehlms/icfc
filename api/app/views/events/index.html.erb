<div data-controller="modal">
<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold text-emerald-900">Events</h1>
  <button data-action="click->modal#open" class="btn-primary">New Event</button>
</div>

<%# Week navigation %>
<div class="flex items-center justify-between mb-4 bg-white rounded-lg shadow px-4 py-3">
  <%= link_to events_path(week: (@week_start - 7).iso8601),
        class: "text-emerald-700 hover:text-emerald-900 font-medium text-sm",
        data: { turbo_frame: "calendar" } do %>
    ← Prev week
  <% end %>

  <span class="font-semibold text-gray-700">
    <%= @week_start.strftime('%B %-d') %> – <%= @week_end.strftime('%B %-d, %Y') %>
  </span>

  <%= link_to events_path(week: (@week_start + 7).iso8601),
        class: "text-emerald-700 hover:text-emerald-900 font-medium text-sm",
        data: { turbo_frame: "calendar" } do %>
    Next week →
  <% end %>
</div>

<%# Weekly calendar grid %>
<turbo-frame id="calendar">
  <div class="bg-white rounded-lg shadow overflow-hidden mb-6">
    <%# Day headers %>
    <div class="grid grid-cols-7 border-b">
      <% @week_days.each do |day| %>
        <div class="px-2 py-2 text-center border-r last:border-r-0
                    <%= day == Date.today ? 'bg-emerald-50' : 'bg-gray-50' %>">
          <p class="text-xs font-medium text-gray-500 uppercase"><%= day.strftime('%a') %></p>
          <p class="text-lg font-semibold <%= day == Date.today ? 'text-emerald-700' : 'text-gray-800' %>">
            <%= day.strftime('%-d') %>
          </p>
        </div>
      <% end %>
    </div>

    <%# Event cells %>
    <div class="grid grid-cols-7 min-h-48">
      <% @week_days.each do |day| %>
        <div class="border-r last:border-r-0 p-1.5 align-top
                    <%= day == Date.today ? 'bg-emerald-50/40' : '' %>">
          <% (@events_by_day[day] || []).each do |event| %>
            <div class="mb-1 rounded px-1.5 py-1 bg-emerald-100 border-l-2 border-emerald-600 group relative">
              <%= link_to event_path(event), class: "block" do %>
                <p class="text-xs font-semibold text-emerald-900 leading-tight truncate hover:underline" title="<%= event.title %>">
                  <%= event.title %>
                </p>
                <% unless event.all_day? %>
                  <p class="text-xs text-emerald-700">
                    <%= event.start_time.strftime('%-I:%M %p') %>
                  </p>
                <% end %>
              <% end %>
              <% if event.user_id == current_user.id || current_user.admin? %>
                <div class="hidden group-hover:flex absolute top-0.5 right-0.5 gap-0.5">
                  <%= link_to edit_event_path(event),
                        class: "text-emerald-700 hover:text-emerald-900 bg-white rounded p-0.5", title: "Edit" do %>
                    <%= heroicon "pencil-square", options: { class: "w-3 h-3" } %>
                  <% end %>
                  <%= button_to event, method: :delete,
                        class: "text-red-500 hover:text-red-700 bg-white rounded p-0.5",
                        title: "Delete", data: { turbo_confirm: "Delete \"#{event.title}\"?" } do %>
                    <%= heroicon "trash", options: { class: "w-3 h-3" } %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>

<%# New event modal %>
<dialog data-modal-target="dialog" data-action="click->modal#backdropClose" class="modal-dialog">
  <div class="p-6 w-full">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">New Event</h2>
      <button data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
        <%= heroicon "x-mark", options: { class: "w-5 h-5" } %>
      </button>
    </div>
    <%= render "form", event: @event %>
  </div>
</dialog>
</div>
