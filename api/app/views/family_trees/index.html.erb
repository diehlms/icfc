<div data-controller="modal">
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-emerald-900">Family Trees</h1>
  <button data-action="click->modal#open" class="btn-primary">New Family Tree</button>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden" data-controller="table-sort">
  <table class="w-full text-sm" data-table-sort-target="table">
    <thead class="bg-gray-50">
      <tr>
        <th class="text-left px-4 py-2 font-medium text-gray-700" data-sortable>Name</th>
        <th class="text-left px-4 py-2 font-medium text-gray-700" data-sortable>Created By</th>
        <th></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @family_trees.each do |tree| %>
        <tr>
          <td class="px-4 py-2">
            <%= link_to tree.name, family_tree_path(tree), class: "font-medium text-emerald-700 hover:underline" %>
          </td>
          <td class="px-4 py-2 text-gray-600">
            <%= tree.user&.firstname %> <%= tree.user&.lastname %>
          </td>
          <td class="px-4 py-2 text-right">
            <% if tree.user_id == current_user.id || current_user.admin? %>
              <%= button_to family_tree_path(tree), method: :delete,
                    class: "text-gray-400 hover:text-red-500 bg-transparent border-0 cursor-pointer inline-flex",
                    title: "Delete", data: { turbo_confirm: "Delete family tree?" } do %>
                <%= heroicon "trash", options: { class: "w-4 h-4" } %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<dialog data-modal-target="dialog" data-action="click->modal#backdropClose" class="modal-dialog">
  <div class="p-6 w-full">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">New Family Tree</h2>
      <button data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
        <%= heroicon "x-mark", options: { class: "w-5 h-5" } %>
      </button>
    </div>
    <%= form_with model: @family_tree, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
      <% if @family_tree.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
          <ul class="list-disc list-inside space-y-1">
            <% @family_tree.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, required: true, class: "form-control" %>
      </div>
      <%= f.submit "Create", data: { form_validity_target: "submit" }, class: "btn-primary w-full" %>
    <% end %>
  </div>
</dialog>
</div>
