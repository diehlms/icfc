<%
  members_json = @members.map { |m|
    {
      id:           m.id,
      name:         m.name,
      relationship: m.relationship,
      date_of_birth: m.date_of_birth&.strftime('%Y-%m-%d'),
      parent_ids:   m.parent_ids || []
    }
  }.to_json
%>

<div data-controller="modal">
<div class="mb-3 flex items-center justify-between">
  <div class="flex items-center gap-3">
    <%= link_to "← Family Trees", family_trees_path, class: "text-sm text-emerald-700 hover:underline" %>
    <h1 class="text-xl font-bold text-emerald-900"><%= @family_tree.name %></h1>
  </div>
  <div class="flex items-center gap-2">
    <button data-action="click->modal#open" class="btn-primary">+ Add Member</button>
    <% if @family_tree.user_id == current_user.id || current_user.admin? %>
      <%= button_to family_tree_path(@family_tree), method: :delete,
            class: "text-gray-400 hover:text-red-500 bg-transparent border-0 cursor-pointer",
            title: "Delete tree", data: { turbo_confirm: "Delete entire family tree and all members?" } do %>
        <%= heroicon "trash", options: { class: "w-4 h-4" } %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @members.empty? %>
  <div class="bg-white rounded-lg shadow p-12 text-center text-gray-400">
    <p class="text-lg mb-2">No members yet.</p>
    <p class="text-sm">Use "Add Member" to get started, then drag them around and link them together.</p>
  </div>
<% else %>
  <div data-controller="family-tree"
       data-family-tree-members-value="<%= members_json %>"
       data-family-tree-family-tree-id-value="<%= @family_tree.id %>"
       class="relative">

    <div data-family-tree-target="linkHint"
         class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-20 bg-emerald-900 text-white text-sm px-4 py-2 rounded-full shadow-lg flex items-center gap-3">
      <span>Click a node to set it as the <strong>child</strong> of the selected member</span>
      <button data-action="click->family-tree#cancelLink" class="text-emerald-300 hover:text-white font-bold">Cancel</button>
    </div>

    <div data-family-tree-target="canvas"
         class="bg-white rounded-lg shadow overflow-hidden"
         style="height: 580px; touch-action: none;"></div>

    <div data-family-tree-target="panel"
         class="hidden absolute top-4 right-4 w-56 bg-white rounded-lg shadow-xl border border-gray-100 p-4 z-10">
      <h3 class="font-bold text-emerald-900 text-base mb-0.5" data-family-tree-target="panelName"></h3>
      <p class="text-sm text-gray-500 capitalize mb-0.5" data-family-tree-target="panelRelationship"></p>
      <p class="text-xs text-gray-400 mb-4" data-family-tree-target="panelDob"></p>
      <div class="space-y-2">
        <a data-family-tree-target="editLink" href="#"
           class="block text-center text-sm bg-gray-100 hover:bg-gray-200 rounded py-1.5 font-medium">
          Edit
        </a>
        <button data-action="click->family-tree#startLink"
                class="w-full text-sm bg-emerald-100 hover:bg-emerald-200 text-emerald-800 rounded py-1.5 font-medium">
          Link as parent of…
        </button>
        <form data-family-tree-target="deleteForm"
              method="post"
              action="#"
              data-turbo-confirm="Remove this member?"
              class="w-full">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <%= hidden_field_tag :_method, "delete" %>
          <button type="submit"
                  class="w-full text-sm bg-red-50 hover:bg-red-100 text-red-600 rounded py-1.5 font-medium">
            Remove
          </button>
        </form>
      </div>
    </div>
  </div>
<% end %>

<dialog data-modal-target="dialog" data-action="click->modal#backdropClose" class="modal-dialog">
  <div class="p-6 w-full">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold">Add Member</h2>
      <button data-action="click->modal#close" class="text-gray-400 hover:text-gray-600">
        <%= heroicon "x-mark", options: { class: "w-5 h-5" } %>
      </button>
    </div>
    <% member = defined?(@member) && @member.present? ? @member : FamilyMember.new %>
    <%= form_with model: [@family_tree, member], data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
      <% if member.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
          <ul class="list-disc list-inside space-y-1">
            <% member.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div>
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, required: true, class: "form-control" %>
      </div>
      <div>
        <%= f.label :relationship, class: "form-label" %>
        <%= f.select :relationship,
              FamilyMember.relationships.keys.map { |r| [r.capitalize, r] },
              { include_blank: "Select…" },
              class: "form-control" %>
      </div>
      <div>
        <%= f.label :date_of_birth, class: "form-label" %>
        <%= f.date_field :date_of_birth, class: "form-control" %>
      </div>
      <%= render "shared/field_errors", object: member, attribute: :parent_ids %>
      <%= f.submit "Add Member", data: { form_validity_target: "submit" }, class: "btn-primary w-full" %>
    <% end %>
  </div>
</dialog>
</div>
