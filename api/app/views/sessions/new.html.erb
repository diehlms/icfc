<div class="min-h-screen flex items-center justify-center relative"
     style="background-image: url('<%= asset_path('lodge.jpg') %>'); background-size: cover; background-position: bottom;">
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md relative z-10">
    <h1 class="text-2xl font-bold text-emerald-900 mb-6 text-center">Iron City Fishing Club</h1>
    <h2 class="text-lg font-semibold mb-4 text-center text-gray-700">Sign In</h2>

    <%= form_with url: login_path, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, required: true, class: "form-control", autofocus: true %>
      </div>
      <div data-controller="password-visibility">
        <%= f.label :password, "Password", class: "form-label" %>
        <div class="relative">
          <%= f.password_field :password, required: true,
                data: { password_visibility_target: "input" },
                class: "form-control pr-10" %>
          <button type="button" data-action="click->password-visibility#toggle"
                  class="absolute inset-y-0 right-2 flex items-center text-gray-500 hover:text-gray-800 text-xs">
            Show
          </button>
        </div>
      </div>
      <%= f.submit "Sign In", data: { form_validity_target: "submit" }, class: "btn-primary w-full" %>
    <% end %>

    <div class="mt-4 text-center space-y-1 text-sm text-gray-600">
      <p><%= link_to "Forgot password?", new_password_reset_path, class: "text-emerald-700 hover:underline" %></p>
      <p>No account? <%= link_to "Sign up", signup_path, class: "text-emerald-700 hover:underline" %></p>
    </div>
  </div>
</div>
