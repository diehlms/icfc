<div class="min-h-screen bg-gray-100 flex items-center justify-center">
  <div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md">
    <h2 class="text-xl font-bold text-emerald-900 mb-6 text-center">Set New Password</h2>

    <%= form_with model: @user, url: edit_password_reset_path, method: :patch, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
      <%= hidden_field_tag :token, params[:token] %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div data-controller="password-strength">
        <div data-controller="password-visibility">
          <%= f.label :password, "New Password", class: "form-label" %>
          <div class="relative">
            <%= f.password_field :password, required: true, minlength: 8,
                  data: { password_visibility_target: "input",
                          password_strength_target: "input",
                          action: "input->password-strength#check" },
                  class: "form-control pr-10" %>
            <button type="button" data-action="click->password-visibility#toggle"
                    class="absolute inset-y-0 right-2 flex items-center text-gray-500 hover:text-gray-800 text-xs">
              Show
            </button>
          </div>
        </div>
        <ul data-password-strength-target="rules" class="mt-2 space-y-1 text-xs"></ul>
        <%= render "shared/field_errors", object: @user, attribute: :password %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirm New Password", class: "form-label" %>
        <%= f.password_field :password_confirmation, required: true, class: "form-control" %>
      </div>
      <%= f.submit "Update Password", data: { form_validity_target: "submit" }, class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
