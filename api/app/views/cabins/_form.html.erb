<%= form_with model: cabin, data: { controller: "form-validity" }, class: "space-y-4" do |f| %>
  <% if cabin.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% cabin.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "form-label" do %>Name<%= required_mark %><% end %>
    <%= f.text_field :name, required: true, class: "form-control" %>
    <%= render "shared/field_errors", object: cabin, attribute: :name %>
  </div>
  <div>
    <%= f.label :bedrooms, class: "form-label" do %>Bedrooms<%= required_mark %><% end %>
    <%= f.number_field :bedrooms, required: true, min: 1, max: 9, class: "form-control" %>
    <%= render "shared/field_errors", object: cabin, attribute: :bedrooms %>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :price_per_day, "Price / Day", class: "form-label" %>
      <%= f.number_field :price_per_day, step: "0.01", class: "form-control" %>
    </div>
    <div>
      <%= f.label :price_per_week, "Price / Week", class: "form-label" %>
      <%= f.number_field :price_per_week, step: "0.01", class: "form-control" %>
    </div>
  </div>
  <div class="flex gap-6">
    <div class="flex items-center gap-2">
      <%= f.check_box :dock, class: "rounded border-gray-300 text-emerald-600" %>
      <%= f.label :dock, "Dock", class: "text-sm text-gray-700" %>
    </div>
    <div class="flex items-center gap-2">
      <%= f.check_box :washerdryer, class: "rounded border-gray-300 text-emerald-600" %>
      <%= f.label :washerdryer, "Washer / Dryer", class: "text-sm text-gray-700" %>
    </div>
  </div>
  <div>
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit cabin.persisted? ? "Save Changes" : "Add Cabin", data: { form_validity_target: "submit" }, class: "btn-primary" %>
    <% if cabin.persisted? %>
      <%= link_to "Cancel", cabin, class: "text-sm text-gray-500 hover:underline self-center" %>
    <% end %>
  </div>
<% end %>
