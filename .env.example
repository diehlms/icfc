# Copy to .env at the repo root. The devcontainer loads it into the app container.
# Postgres and Redis settings are provided by .devcontainer/docker-compose.yml.

# Required to boot in development (config/environments/development.rb)
DEFAULT_FROM_EMAIL_ADDRESS=dev@example.com
SMTP_HOST=localhost
SMTP_USERNAME=dev
SMTP_PASSWORD=dev

# Optional
# RECAPTCHA_SECRET_KEY=
# ROLLBAR_ACCESS_TOKEN=
